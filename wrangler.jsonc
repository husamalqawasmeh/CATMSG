{
  "name": "catmsg",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CATMSG_STORE",
        "class_name": "CatMsgStorageDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CatMsgStorageDO"]
    }
  ],
  "routes": [
    {
      "pattern": "cats.can-du-ai.com",
      "custom_domain": true
    }
  ]
}
